[Unit]
Description=Alertmanager to Icinga bridge
Documentation=https://github.com/NETWAYS/alertmanager-icinga-bridge
Wants=network-online.target
After=network-online.target icinga2.service

[Service]
Type=simple
User=alertmanager-icinga-bridge
Group=alertmanager-icinga-bridge
EnvironmentFile=/etc/alertmanager-icinga-bridge/environment
ExecStart=/usr/bin/alertmanager-icinga-bridge
# Re-reads the host mapping file
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5s

# Uncomment to listen on a port below 1024
#AmbientCapabilities=CAP_NET_BIND_SERVICE
#CapabilityBoundingSet=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service

[Install]
WantedBy=multi-user.target
